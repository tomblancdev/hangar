# The bench's tools: QEMU to run a throwaway Proxmox VE, and Proxmox's own
# auto-install assistant to install it with no hand on the keyboard. Nothing
# of this lands on the machine that runs the bench but this image and a cache
# directory.
FROM docker.io/library/debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      qemu-system-x86 qemu-utils xorriso ca-certificates curl openssh-client \
 && rm -rf /var/lib/apt/lists/*

# The assistant ships in Proxmox's repository, signed by its archive key —
# checked against the hash published beside the release notes.
ARG PVE_KEYRING_SHA256=136673be77aba35dcce385b28737689ad64fd785a797e57897589aed08db6e45
RUN curl -fsSL -o /usr/share/keyrings/proxmox-archive-keyring.gpg \
      https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg \
 && echo "$PVE_KEYRING_SHA256  /usr/share/keyrings/proxmox-archive-keyring.gpg" | sha256sum -c \
 && printf '%s\n' 'Types: deb' 'URIs: http://download.proxmox.com/debian/pve' 'Suites: trixie' \
      'Components: pve-no-subscription' 'Signed-By: /usr/share/keyrings/proxmox-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/pve.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends proxmox-auto-install-assistant \
 && rm -rf /var/lib/apt/lists/*
